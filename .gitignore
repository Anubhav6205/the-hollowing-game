# Ignore everything by default
*

# Allow Git metadata
!.gitignore

# Allow folders leading to scripts
!Assets/
!Assets/Main/
!Assets/Main/Scripts/
!README.md
!LICENSE
!docs/
!docs/*.pdf
!AIUsageReport.pdf

# Allow only C# script files inside Scripts folder
!Assets/Main/Scripts/

# Exclude meta files, unless you want to keep them
*.meta

# Static project page for Vercel
!index.html
!vercel.json
!.vercelignore

.vercel
